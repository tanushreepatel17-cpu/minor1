# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit the real .env.
#
# On Render/Vercel, set the same keys in the dashboard. VITE_* values are baked
# into the browser bundle at build time, so they must exist when the build runs.
# ---------------------------------------------------------------------------

# Supabase (browser + SSR)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
# Server only. Creates officer accounts; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres connection for migrations only (not needed by the deployed app).
DATABASE_URL=""

# Sahayak assistant. Optional: without a key the built-in scheme engine answers.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
OPENAI_BASE_URL=""
OPENAI_API_KEY=""

# Shared secret for scheduled jobs, if enabled.
CRON_SECRET=""
